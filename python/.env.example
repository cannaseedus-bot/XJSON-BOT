# XJSON-BOT API Server Configuration
# Copy to .env and fill in your values

# ==================== SERVER ====================
HOST=0.0.0.0
PORT=8000
DEBUG=false
WORKERS=4

# ==================== SECURITY ====================
# Set to true to require API keys for all requests
API_KEY_REQUIRED=false
# Comma-separated list of valid API keys
API_KEYS=sk-your-key-here,sk-another-key

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ==================== DATABASE ====================
DATABASE_URL=sqlite+aiosqlite:///./xjson.db
REDIS_URL=redis://localhost:6379

# ==================== MODEL PROVIDERS ====================
# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# ==================== DEFAULT MODELS ====================
DEFAULT_CHAT_MODEL=gpt-4o-mini
DEFAULT_IMAGE_MODEL=janus-1.3b
DEFAULT_REASONING_MODEL=deepseek-r1

# ==================== JANUS (LOCAL) ====================
JANUS_MODEL_PATH=deepseek-ai/Janus-1.3B
JANUS_DEVICE=cuda
JANUS_BATCH_SIZE=4

# ==================== PATHS ====================
MODELS_DIR=./models
CACHE_DIR=./cache
UPLOADS_DIR=./uploads

# ==================== LIMITS ====================
MAX_TOKENS=4096
MAX_CONTEXT_LENGTH=128000
