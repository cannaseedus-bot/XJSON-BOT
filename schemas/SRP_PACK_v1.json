{
  "@id": "asx://fold/srp.pack.v1",
  "@type": "srp.pack",
  "@version": "1.0.0",
  "@status": "locked",
  "@title": "SRP_PACK_v1 — System Runtime Preprocessor (ASX-R v1 Locked Fold)",
  "@timestamp": 1735570800000,
  "@locks": {
    "@asx_r": "asx://layer/asx-r.v1",
    "@phase_model": ["@pop", "@wo", "@sek", "@collapse", "@project"],
    "@determinism": true,
    "@replay_verification": "hash_chain_v1"
  },

  "@formal_definition": {
    "@name": "SRP (System Runtime Preprocessor)",
    "@role": "always-callable runtime preprocessor",
    "@definition": "SRP is an ASX-R v1 subsystem that accepts declarative events, advances a deterministic tick, collapses state via XCFE-governed directives, and projects outputs to runtime surfaces (:root CSS vars, DOM projections, GPU/SVG-3D ops, MeshChain contract hooks). It replaces line-by-line scripting with lawful state transitions and verifiable replay.",
    "@core_law": "SRP is not a request handler. SRP is a continuously active runtime that preprocesses system state before projection.",
    "@comparison": {
      "PHP": { "triggered": "by request", "execution": "linear", "state": "stateless unless persisted", "output": "HTML" },
      "SRP": { "triggered": "always resident", "execution": "tick-based", "state": "event-sourced", "output": "projections" }
    }
  },

  "srp_spec": {
    "kernel_phases": ["submit", "tick", "collapse", "project", "verify"],
    "execution_contract": {
      "flow": "submit → log, tick → reduce, collapse → commit, project → emit",
      "law": "No other order is legal"
    },
    "determinism_law": {
      "ordering": [
        "events sorted by (ts, id)",
        "directives sorted by (order, id)",
        "delta ops applied in stable order"
      ],
      "no_eval": true,
      "no_time_reads": true,
      "no_rng": true
    }
  },

  "schemas": {
    "asx://schema/srp.class.v1": {
      "$schema": "xjson://schema/draft/2020-12",
      "$id": "asx://schema/srp.class.v1",
      "title": "SRP Class v1",
      "type": "object",
      "required": ["@id", "@type", "@version", "state0", "reducers", "projection"],
      "properties": {
        "@id": { "type": "string", "pattern": "^asx://srp/class/" },
        "@type": { "const": "srp.class" },
        "@version": { "type": "string" },
        "meta": { "type": "object", "additionalProperties": true },
        "state0": { "type": "object", "additionalProperties": true },
        "reducers": {
          "type": "object",
          "description": "Event-type → reducer (SRP directives).",
          "additionalProperties": { "$ref": "asx://schema/srp.directive.v1" }
        },
        "projection": { "$ref": "asx://schema/srp.projection.v1" },
        "xcfe_binding": {
          "type": "object",
          "description": "Formal SRP ↔ XCFE binding: directives are XCFE blocks.",
          "properties": {
            "@control_domain": { "type": "string", "default": "XCFE" },
            "@mapping": {
              "type": "object",
              "properties": {
                "directive_as_control": { "const": true },
                "submit_as_event": { "const": true },
                "tick_as_phase": { "const": true },
                "collapse_as_delta": { "const": true },
                "project_as_view": { "const": true }
              },
              "required": ["directive_as_control", "submit_as_event", "tick_as_phase", "collapse_as_delta", "project_as_view"]
            }
          },
          "required": ["@control_domain", "@mapping"]
        }
      },
      "additionalProperties": false
    },

    "asx://schema/srp.event.v1": {
      "$schema": "xjson://schema/draft/2020-12",
      "$id": "asx://schema/srp.event.v1",
      "title": "SRP Event v1",
      "type": "object",
      "required": ["@id", "@type", "@ts", "class_id", "event_type"],
      "properties": {
        "@id": { "type": "string", "pattern": "^asx://srp/event/" },
        "@type": { "const": "srp.event" },
        "@ts": { "type": "integer", "minimum": 0 },
        "class_id": { "type": "string" },
        "event_type": { "type": "string" },
        "payload": { "type": "object", "additionalProperties": true },
        "nonce": { "type": "integer", "minimum": 0 },
        "prev_hash": { "type": "string" },
        "hash": { "type": "string" }
      },
      "additionalProperties": false
    },

    "asx://schema/srp.directive.v1": {
      "$schema": "xjson://schema/draft/2020-12",
      "$id": "asx://schema/srp.directive.v1",
      "title": "SRP Directive v1",
      "description": "A reducer written as declarative control, not JS. This is the SRP unit.",
      "type": "object",
      "required": ["@control"],
      "properties": {
        "@control": {
          "type": "object",
          "required": ["@if", "@then"],
          "properties": {
            "@if": { "type": "object", "additionalProperties": true },
            "@then": { "type": "object", "additionalProperties": true },
            "@else": { "type": "object", "additionalProperties": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "asx://schema/srp.delta.v1": {
      "$schema": "xjson://schema/draft/2020-12",
      "$id": "asx://schema/srp.delta.v1",
      "title": "SRP Delta v1",
      "type": "object",
      "required": ["@id", "@type", "class_id", "tick", "patch"],
      "properties": {
        "@id": { "type": "string", "pattern": "^asx://srp/delta/" },
        "@type": { "const": "srp.delta" },
        "class_id": { "type": "string" },
        "tick": { "type": "integer", "minimum": 0 },
        "patch": {
          "type": "array",
          "description": "Deterministic patch ops: set, inc, push, del.",
          "items": {
            "type": "object",
            "required": ["op", "path"],
            "properties": {
              "op": { "enum": ["set", "inc", "push", "del"] },
              "path": { "type": "string" },
              "value": {}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "asx://schema/srp.projection.v1": {
      "$schema": "xjson://schema/draft/2020-12",
      "$id": "asx://schema/srp.projection.v1",
      "title": "SRP Projection v1",
      "type": "object",
      "required": ["css_root", "gpu_bridge", "meshchain_hooks"],
      "properties": {
        "css_root": {
          "type": "object",
          "description": "SRP → :root atomic projection compiler mapping.",
          "properties": {
            "vars": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "description": "CSS var name → JSON pointer-like read path (e.g. /state/slider)."
            }
          },
          "required": ["vars"],
          "additionalProperties": false
        },
        "gpu_bridge": {
          "type": "object",
          "description": "SRP → GPU/SVG-3D bridge mapping.",
          "properties": {
            "mode": { "enum": ["webgl_min", "svg3d_min"], "default": "webgl_min" },
            "inputs": { "type": "object", "additionalProperties": { "type": "string" } }
          },
          "required": ["mode", "inputs"],
          "additionalProperties": false
        },
        "meshchain_hooks": {
          "type": "object",
          "description": "SRP → MeshChain execution hooks (contracts).",
          "properties": {
            "mint_route": { "type": "string", "default": "/mesh/contract/execute" },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["when", "then"],
                "properties": {
                  "when": { "type": "object", "additionalProperties": true },
                  "then": { "type": "object", "additionalProperties": true }
                },
                "additionalProperties": false
              }
            }
          },
          "required": ["mint_route", "rules"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },

  "formal_bindings": {
    "SRP↔XCFE": {
      "@law": "SRP directives MUST be valid XCFE control-flow blocks. SRP does not invent control semantics; it reuses XCFE '@if/@then/@else' and applies deterministic delta ops.",
      "@mapping": {
        "SRP.@control.@if": "XCFE.@if predicate (pure data predicate)",
        "SRP.@control.@then/@else": "XCFE branches -> SRP.delta.v1 patch ops"
      },
      "@invariants": [
        "No eval, no code strings as authority",
        "Branch selection is deterministic given (state,event)",
        "Delta ops are ordered and replayable"
      ]
    },

    "SRP→CSS_root_compiler": {
      "@law": "Projection is a pure function of (state, last_delta, tick). Output is emitted as :root CSS variables only; DOM reads vars.",
      "@compiler_rule": "For each projection.emit item type=css_var: resolve value_path from state; stringify; emit to :root as '--var: value;'."
    },

    "SRP→GPU_SVG3D_bridge": {
      "@law": "GPU/SVG-3D is driven by an ops queue derived from projection. SRP never calls WebGL directly; kernel enqueues ops into a runtime channel consumed by the GPU shard/runtime.",
      "@op_shapes": [
        { "op": "mesh.translate", "args": { "id": "node:0", "x": 0, "y": 0, "z": 0 } },
        { "op": "mesh.rotate", "args": { "id": "node:0", "rx": 0, "ry": 0, "rz": 0 } },
        { "op": "hud.text", "args": { "id": "hud:counter", "text": "10" } }
      ]
    },

    "SRP→MeshChain_hooks": {
      "@law": "MeshChain hooks are emitted as mesh_tx projection items and routed to the MeshChain executor. SRP itself remains non-transactional; it only produces the deterministic intent envelope.",
      "@mapping": {
        "projection.emit[type=mesh_tx]": "meshchain.execute(contract_id, action, args)"
      }
    }
  },

  "demo_class": {
    "@id": "asx://srp/class/demo.slider_cube_mint.v1",
    "@type": "srp.class",
    "@version": "1.0.0",
    "meta": { "label": "Slider → CSS → GPU → MeshChain mint", "author": "ASX" },
    "state0": {
      "slider": 0.25,
      "active": false,
      "tick": 0,
      "minted": 0,
      "mint_armed": true
    },
    "reducers": {
      "ui/slider": {
        "@control": {
          "@if": { "always": true },
          "@then": { "delta": [{ "op": "set", "path": "/slider", "value": { "$ref": "payload/value" } }] }
        }
      },
      "srp/tick": {
        "@control": {
          "@if": { "always": true },
          "@then": {
            "delta": [
              { "op": "inc", "path": "/tick", "value": 1 },
              { "op": "set", "path": "/active", "value": true }
            ],
            "hooks": [
              {
                "meshchain": {
                  "when": { "gt": ["/slider", 0.7], "and": [{ "eq": ["/mint_armed", true] }] },
                  "then": { "mint": { "asset": "ASX_DEMO", "amount": 1 }, "set": { "/mint_armed": false }, "inc": { "/minted": 1 } }
                }
              },
              {
                "meshchain": {
                  "when": { "lt": ["/slider", 0.65] },
                  "then": { "set": { "/mint_armed": true } }
                }
              }
            ]
          }
        }
      }
    },
    "projection": {
      "css_root": {
        "vars": {
          "--srp_slider": "/slider",
          "--srp_tick": "/tick",
          "--srp_minted": "/minted"
        }
      },
      "gpu_bridge": {
        "mode": "webgl_min",
        "inputs": { "angle": "/slider" }
      },
      "meshchain_hooks": {
        "mint_route": "/mesh/contract/execute",
        "rules": [
          { "when": { "slider_gt": 0.7 }, "then": { "mint": true } }
        ]
      }
    },
    "xcfe_binding": {
      "@control_domain": "XCFE",
      "@mapping": {
        "directive_as_control": true,
        "submit_as_event": true,
        "tick_as_phase": true,
        "collapse_as_delta": true,
        "project_as_view": true
      }
    }
  },

  "conformance_suite": {
    "@id": "asx://srp/conformance/suite.v1",
    "@type": "srp.conformance_suite",
    "@version": "1.0.0",
    "vectors": [
      {
        "@id": "asx://srp/vector/boot.v1",
        "name": "boot initializes state + empty log",
        "steps": [
          { "op": "boot", "state0": { "slider": 0.25, "active": false, "tick": 0, "minted": 0, "mint_armed": true } }
        ],
        "expect": { "state": { "tick": 0, "minted": 0 }, "log_len": 1 }
      },
      {
        "@id": "asx://srp/vector/slider_then_tick_no_mint.v1",
        "name": "slider=0.4 then tick => no mint",
        "steps": [
          { "op": "boot" },
          { "op": "submit", "event_type": "ui/slider", "payload": { "value": 0.4 } },
          { "op": "tick" }
        ],
        "expect": { "state": { "minted": 0, "active": true, "tick": 1 }, "mint_calls": 0 }
      },
      {
        "@id": "asx://srp/vector/mint_threshold_cross.v1",
        "name": "slider crosses >0.7 then tick => mint once, re-arm below 0.65",
        "steps": [
          { "op": "boot" },
          { "op": "submit", "event_type": "ui/slider", "payload": { "value": 0.75 } },
          { "op": "tick" },
          { "op": "tick" },
          { "op": "submit", "event_type": "ui/slider", "payload": { "value": 0.60 } },
          { "op": "tick" },
          { "op": "submit", "event_type": "ui/slider", "payload": { "value": 0.75 } },
          { "op": "tick" }
        ],
        "expect": { "state": { "minted": 2 }, "mint_calls": 2 }
      },
      {
        "@id": "asx://srp/vector/replay_verify.v1",
        "name": "event log replay produces same projection hash chain",
        "steps": [
          { "op": "boot" },
          { "op": "submit", "event_type": "ui/slider", "payload": { "value": 0.8 } },
          { "op": "tick" },
          { "op": "verify_replay" }
        ],
        "expect": { "verify_ok": true }
      }
    ]
  },

  "replay_verifier_v1": {
    "@id": "asx://srp/replay_verifier.v1",
    "hash": "sha256",
    "canonicalization": "json:sort_keys,separators(',',':')",
    "chain_rule": "H0 = prev || '', Hn = sha256(H(n-1) + '|' + canon(obj_n))",
    "objects_in_chain": ["srp.event", "projection"],
    "verify_outputs": ["ok:boolean", "expected:hex", "got:hex", "log_hash:hex"]
  },

  "rest_mesh_routes": {
    "routes": [
      { "method": "POST", "path": "/srp/submit", "body": "srp.event.v1", "returns": "ack" },
      { "method": "POST", "path": "/srp/tick", "body": "srp.tick.request", "returns": "srp.tick.result" },
      { "method": "POST", "path": "/srp/project", "body": "srp.project.request", "returns": "srp.project.result" },
      { "method": "POST", "path": "/srp/verify", "body": "srp.verify.request", "returns": "srp.verify.result" }
    ]
  },

  "sw_js_stub": {
    "@note": "Routes stub for sw.js; real kernel is SRP_KERNEL_MIN.js",
    "routes": {
      "submit": "/srp/submit",
      "tick": "/srp/tick",
      "project": "/srp/project",
      "verify": "/srp/verify"
    },
    "project_to_css_root": "function(project, rootStyle){ if(!project?.css_root?.vars) return; for(const k in project.css_root.vars) rootStyle.setProperty(k, String(project.css_root.vars[k])); }",
    "project_to_gpu": "function(project, gpu){ if(!project?.gpu_bridge || !gpu?.apply) return; gpu.apply(project.gpu_bridge); }",
    "meshchain_execute": "async function(hook, fetchFn){ if(!hook) return {ok:false}; return fetchFn(hook.route||'/mesh/contract/execute', {method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify(hook.body||{})}); }"
  },

  "@drop_in_manifest_fold": {
    "@manifest_path_hint": "/folds/srp",
    "@install": "Place SRP_PACK_v1.json into manifest.json under folds.srp, load SRP_KERNEL_MIN.js, then: SRP.boot(demo_class)"
  }
}
