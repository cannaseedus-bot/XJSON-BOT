  "default_model": "janus-pro",

  "provider_configs": {
    "mx2lm": {
      "type": "api",
      "base_url": "https://mx2lm.app",
      "api_endpoint": "/api.php",
      "quantum_enabled": true
    },
    "transformers.js": {
      "type": "browser",
      "cdn": "https://cdn.jsdelivr.net/npm/@xenova/transformers@2.17.0",
      "device": "webgpu",
      "fallback_device": "wasm",
      "browser_native": true
    },
    "ollama": {
      "type": "local",
      "base_url": "http://localhost:11434",
      "api_endpoint": "/api/generate"
    },
    "openai": {
      "type": "api",
      "base_url": "https://api.openai.com/v1",
      "requires_key": true
    },
    "deepseek": {
      "type": "api",
      "via_mx2lm": true,
      "quantum_enhanced": true
    },
    "meta": {
      "via_mx2lm": true,
      "models": ["llama3", "codellama"]
    },
    "mistral": {
      "via_mx2lm": true
    },
    "qwen": {
      "via_mx2lm": true
    }
  },

