{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xjson-bot.dev/schemas/asx-inference-response.schema.json",
  "title": "ASX Inference Response",
  "description": "Inference Plane v1 response schema",
  "type": "object",
  "required": ["type", "id", "model", "choices"],
  "properties": {
    "type": {
      "const": "asx-inference-response",
      "description": "Inference response type"
    },
    "id": {
      "type": "string",
      "description": "Matching request ID"
    },
    "model": {
      "type": "string",
      "description": "Model used for inference"
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "message", "finish_reason"],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": {
                "const": "assistant"
              },
              "content": {
                "type": "string"
              },
              "reasoning": {
                "type": "string",
                "description": "Chain-of-thought reasoning (DeepSeek R1)"
              }
            }
          },
          "finish_reason": {
            "enum": ["stop", "length", "content_filter", "tool_calls"],
            "description": "Reason for completion"
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Tokens used for reasoning (R1 models)"
        }
      }
    },
    "trace": {
      "$ref": "execution-trace.schema.json",
      "description": "Execution trace for replay verification"
    }
  },
  "examples": [
    {
      "type": "asx-inference-response",
      "id": "infer_1704067200000",
      "model": "gpt-4o-mini",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "Hello! How can I help you today?"
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "prompt_tokens": 20,
        "completion_tokens": 10,
        "total_tokens": 30
      },
      "trace": {
        "trace_id": "trace_infer_1704067200000",
        "phases": [
          { "phase": "@Pop", "duration_ms": 5 },
          { "phase": "@Wo", "duration_ms": 150 },
          { "phase": "@Collapse", "duration_ms": 3 }
        ],
        "hash": "sha256:abc123..."
      }
    }
  ]
}
