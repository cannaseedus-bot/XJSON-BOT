{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xjson-bot.dev/schemas/asx-image-inference-response.schema.json",
  "title": "ASX Image Inference Response",
  "description": "Image Inference Plane v1 response schema",
  "type": "object",
  "required": ["type", "id", "task", "model"],
  "properties": {
    "type": {
      "const": "asx-image-inference-response",
      "description": "Image inference response type"
    },
    "id": {
      "type": "string",
      "description": "Matching request ID"
    },
    "task": {
      "enum": ["generate", "understand", "transform"],
      "description": "Task that was performed"
    },
    "model": {
      "type": "string",
      "description": "Model used for inference"
    },
    "data": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "image": {
                "type": "string",
                "description": "Generated image (URL or base64)"
              },
              "revised_prompt": {
                "type": "string",
                "description": "Revised prompt used for generation"
              }
            }
          },
          "description": "Array of generated images (generate task)"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "description": "Structured output (understand task)"
        }
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Tokens from input prompt/image"
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Tokens for output"
        },
        "image_cost": {
          "type": "number",
          "minimum": 0,
          "description": "Cost units for image generation"
        }
      }
    },
    "trace": {
      "$ref": "execution-trace.schema.json",
      "description": "Execution trace for replay verification"
    }
  },
  "examples": [
    {
      "type": "asx-image-inference-response",
      "id": "img_gen_1704067200000",
      "task": "generate",
      "model": "janus-pro-7b",
      "data": [
        {
          "index": 0,
          "image": "data:image/png;base64,...",
          "revised_prompt": "A serene mountain landscape at sunset, digital art style, highly detailed"
        }
      ],
      "trace": {
        "trace_id": "trace_img_1704067200000",
        "phases": [
          { "phase": "@Pop", "duration_ms": 10 },
          { "phase": "@Wo", "duration_ms": 2500 },
          { "phase": "@Collapse", "duration_ms": 50 }
        ],
        "hash": "sha256:..."
      }
    },
    {
      "type": "asx-image-inference-response",
      "id": "img_understand_1704067200000",
      "task": "understand",
      "model": "janus-pro-7b",
      "data": {
        "description": "A photograph of a golden retriever playing in a park",
        "objects": ["dog", "grass", "trees", "ball"],
        "colors": ["golden", "green", "brown"],
        "mood": "playful"
      }
    }
  ]
}
