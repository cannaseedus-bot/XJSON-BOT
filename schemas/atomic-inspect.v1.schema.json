{
  "$schema": "xjson://schema/draft/2020-12",
  "$id": "atomic-inspect://schema/v1",
  "$comment": "Introspection Surface (Sealed) - Read-only reflection and debugging",
  "title": "atomic-inspect",
  "description": "Read-only introspection surface for atomic-script debugging. Never modifies state. Pure observation.",
  "type": "object",
  "required": ["@inspect"],
  "additionalProperties": false,

  "properties": {
    "@inspect": {
      "type": "object",
      "required": ["@version", "@target"],
      "additionalProperties": false,
      "properties": {
        "@version": { "const": "v1" },
        "@target": {
          "type": "string",
          "enum": ["script", "state", "trace", "law", "binding", "shape", "effect", "time", "memory"],
          "description": "Inspection target type"
        },
        "@id": {
          "type": "string",
          "description": "Target identifier to inspect"
        }
      }
    },

    "@script_info": {
      "type": "object",
      "description": "Script introspection (read-only)",
      "additionalProperties": false,
      "properties": {
        "@id": { "type": "string" },
        "@type": { "const": "atomic-script" },
        "@version": { "type": "string" },
        "@law": { "type": "string" },
        "@ops_count": { "type": "integer", "minimum": 0 },
        "@phases_used": {
          "type": "array",
          "items": { "type": "string" }
        },
        "@capabilities_required": {
          "type": "array",
          "items": { "type": "string" }
        },
        "@effects_declared": {
          "type": "array",
          "items": { "type": "string" }
        },
        "@bindings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "@state_snapshot": {
      "type": "object",
      "description": "State introspection (read-only point-in-time)",
      "additionalProperties": false,
      "properties": {
        "@tick": { "type": "integer", "minimum": 0 },
        "@phase": { "type": "string" },
        "@values": {
          "type": "object",
          "additionalProperties": true,
          "description": "Current state values (serialized)"
        },
        "@shapes": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Shape IDs for each value"
        },
        "@tiers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Memory tier for each value"
        },
        "@versions": {
          "type": "object",
          "additionalProperties": { "type": "integer" },
          "description": "Version number for each value"
        }
      }
    },

    "@trace": {
      "type": "object",
      "description": "Execution trace (read-only history)",
      "additionalProperties": false,
      "properties": {
        "@events": {
          "type": "array",
          "items": { "$ref": "#/$defs/trace_event" },
          "description": "Ordered list of execution events"
        },
        "@start_tick": { "type": "integer", "minimum": 0 },
        "@end_tick": { "type": "integer", "minimum": 0 },
        "@phases_traversed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "@total_ops": { "type": "integer", "minimum": 0 },
        "@wall_time_ms": { "type": "number", "minimum": 0 }
      }
    },

    "@law_info": {
      "type": "object",
      "description": "Law introspection (read-only)",
      "additionalProperties": false,
      "properties": {
        "@id": { "type": "string" },
        "@allow": { "type": "array", "items": { "type": "string" } },
        "@deny": { "type": "array", "items": { "type": "string" } },
        "@scope": { "type": "string" },
        "@barrier_state": { "type": "string" },
        "@effective_capabilities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Computed: allow - deny"
        }
      }
    },

    "@binding_info": {
      "type": "object",
      "description": "Binding introspection (read-only)",
      "additionalProperties": false,
      "properties": {
        "@surface": { "type": "string" },
        "@script": { "type": "string" },
        "@trigger": { "type": "string" },
        "@priority": { "type": "integer" },
        "@guard": { "type": "string" },
        "@is_active": { "type": "boolean" },
        "@invocation_count": { "type": "integer", "minimum": 0 }
      }
    },

    "@shape_info": {
      "type": "object",
      "description": "Shape introspection (read-only)",
      "additionalProperties": false,
      "properties": {
        "@id": { "type": "string" },
        "@type": { "type": "string" },
        "@constraints": { "type": "object" },
        "@current_valid": { "type": "boolean" },
        "@violations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "@effect_info": {
      "type": "object",
      "description": "Effect introspection (read-only)",
      "additionalProperties": false,
      "properties": {
        "@capability": { "type": "string" },
        "@contains": { "type": "array", "items": { "type": "string" } },
        "@excludes": { "type": "array", "items": { "type": "string" } },
        "@requires": { "type": "array", "items": { "type": "string" } },
        "@is_allowed": { "type": "boolean" },
        "@denial_reason": { "type": "string" }
      }
    },

    "@time_info": {
      "type": "object",
      "description": "Time introspection (read-only)",
      "additionalProperties": false,
      "properties": {
        "@current_tick": { "type": "integer", "minimum": 0 },
        "@current_frame": { "type": "integer", "minimum": 0 },
        "@current_phase": { "type": "string" },
        "@wall_time_ms": { "type": "number" },
        "@ticks_this_frame": { "type": "integer", "minimum": 0 },
        "@frame_budget_remaining_ms": { "type": "number" }
      }
    },

    "@memory_info": {
      "type": "object",
      "description": "Memory introspection (read-only)",
      "additionalProperties": false,
      "properties": {
        "@allocations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "@id": { "type": "string" },
              "@tier": { "type": "string" },
              "@bytes": { "type": "integer", "minimum": 0 },
              "@created_tick": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "@total_bytes": { "type": "integer", "minimum": 0 },
        "@bytes_by_tier": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "@gc_pending": { "type": "boolean" }
      }
    },

    "@breakpoint": {
      "type": "object",
      "description": "Breakpoint definition (observation only)",
      "additionalProperties": false,
      "properties": {
        "@id": { "type": "string" },
        "@type": {
          "type": "string",
          "enum": ["tick", "phase", "op", "state_change", "capability_check", "law_violation"]
        },
        "@condition": {
          "type": "string",
          "description": "Condition expression (evaluated read-only)"
        },
        "@enabled": { "type": "boolean", "default": true },
        "@hit_count": { "type": "integer", "minimum": 0 }
      }
    },

    "@watch": {
      "type": "object",
      "description": "Watch expression (read-only observation)",
      "additionalProperties": false,
      "properties": {
        "@id": { "type": "string" },
        "@expression": {
          "type": "string",
          "description": "Expression to evaluate (read-only)"
        },
        "@current_value": {
          "description": "Last evaluated value"
        },
        "@history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "@tick": { "type": "integer" },
              "@value": {}
            }
          }
        }
      }
    }
  },

  "$defs": {
    "trace_event": {
      "type": "object",
      "required": ["@tick", "@type"],
      "additionalProperties": false,
      "properties": {
        "@tick": { "type": "integer", "minimum": 0 },
        "@phase": { "type": "string" },
        "@type": {
          "type": "string",
          "enum": [
            "op_start", "op_end", "op_error",
            "phase_enter", "phase_exit",
            "state_read", "state_write",
            "capability_check", "capability_granted", "capability_denied",
            "binding_invoked", "guard_evaluated",
            "collapse", "abort"
          ]
        },
        "@op": { "type": "string" },
        "@args": { "type": "object" },
        "@result": {},
        "@error": { "type": "string" },
        "@wall_time_ms": { "type": "number", "minimum": 0 }
      }
    }
  },

  "@invariants": [
    "Inspection NEVER modifies state",
    "All introspection is point-in-time snapshot",
    "Breakpoints observe but never halt (async notification)",
    "Watch expressions are pure (no side effects)",
    "Trace events are append-only",
    "Introspection requires 'audit' capability",
    "No introspection during pi_collapse phase"
  ]
}
