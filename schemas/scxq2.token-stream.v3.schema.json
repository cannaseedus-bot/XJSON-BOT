{
  "$schema": "xjson://schema/draft/2020-12",
  "$id": "scxq2://schema/token_stream.v3",
  "$comment": "SCXQ2 Token Stream v3 (Sealed) - Encoded symbolic intent",
  "title": "SCXQ2 Token Stream v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["@scxq2", "@mode", "@text"],
  "properties": {
    "@scxq2": { "const": "v3" },
    "@mode": {
      "type": "string",
      "enum": ["scx", "scxq2_alias"]
    },
    "@text": {
      "type": "string",
      "minLength": 1
    },
    "@key_hint": { "type": "string" },
    "@rotation": { "type": "boolean" }
  }
}
