{
  "$schema": "asx://schema/xjson.draft/2020-12",
  "$id": "asx://schema/srp.delta.v1",
  "$comment": "SRP Delta Schema v1 - Atomic state change unit (replaces setState)",
  "title": "SRP Delta",
  "description": "Atomic, replayable state change packet. Deltas are the only mutation primitive in SRP.",
  "type": "object",
  "additionalProperties": false,
  "required": ["@type", "@writes"],
  "properties": {
    "@type": {
      "const": "srp.delta.v1",
      "description": "Schema type identifier"
    },
    "@id": {
      "type": "string",
      "pattern": "^delta:[a-z0-9]+$",
      "description": "Unique delta identifier for replay tracking"
    },
    "@ts": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix timestamp when delta was created"
    },
    "@source": {
      "type": "string",
      "description": "Directive or event that produced this delta"
    },
    "@writes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value"],
        "properties": {
          "op": {
            "type": "string",
            "enum": ["set", "merge", "toggle", "inc", "dec", "push", "pop", "remove", "clear"],
            "default": "set",
            "description": "Write operation type"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Dot-notation path to state location"
          },
          "value": {
            "description": "Value to write (interpretation depends on op)"
          },
          "prev": {
            "description": "Previous value (for undo/replay verification)"
          }
        }
      },
      "description": "Array of state write operations"
    },
    "@emits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "value"],
        "properties": {
          "surface": {
            "type": "string",
            "enum": ["view", "css", "route", "io", "network", "storage"],
            "description": "Output surface for projection"
          },
          "value": {
            "description": "Value to emit to surface"
          },
          "selector": {
            "type": "string",
            "description": "Optional CSS selector for DOM surfaces"
          }
        }
      },
      "description": "Side-effect emissions to output surfaces"
    },
    "@hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 hash of delta for verification"
    },
    "@meta": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional metadata"
    }
  },
  "examples": [
    {
      "@type": "srp.delta.v1",
      "@id": "delta:abc123",
      "@ts": 1735570800000,
      "@source": "dir:toggle_panel",
      "@writes": [
        { "path": "ui.state", "value": "active", "prev": "inactive" }
      ],
      "@emits": [
        { "surface": "view", "value": "active" }
      ]
    },
    {
      "@type": "srp.delta.v1",
      "@writes": [
        { "op": "inc", "path": "counter.value", "value": 1, "prev": 5 },
        { "op": "push", "path": "log.entries", "value": { "action": "increment", "ts": 1735570800000 } }
      ],
      "@emits": [
        { "surface": "css", "value": "--counter-value: 6", "selector": ":root" }
      ]
    },
    {
      "@type": "srp.delta.v1",
      "@id": "delta:phase_transition",
      "@source": "evt:phase_complete:def456",
      "@writes": [
        { "op": "set", "path": "phases.pop.status", "value": "completed" },
        { "op": "set", "path": "phases.pop.completed_at", "value": 1735570800000 },
        { "op": "set", "path": "phases.wo.status", "value": "active" }
      ],
      "@emits": [
        { "surface": "view", "value": "wo", "selector": "#phase-indicator" }
      ]
    }
  ]
}
