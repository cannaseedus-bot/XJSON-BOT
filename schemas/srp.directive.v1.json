{
  "$schema": "asx://schema/xjson.draft/2020-12",
  "$id": "asx://schema/srp.directive.v1",
  "$comment": "SRP Directive Schema v1 - Replaces imperative functions with declarative control",
  "title": "SRP Directive",
  "description": "Structured control directive that replaces imperative function calls. Directives are serializable, replayable, and compressible.",
  "type": "object",
  "additionalProperties": false,
  "required": ["@type", "@control"],
  "properties": {
    "@type": {
      "const": "srp.directive.v1",
      "description": "Schema type identifier"
    },
    "@id": {
      "type": "string",
      "pattern": "^dir:[a-z0-9_]+$",
      "description": "Optional directive identifier"
    },
    "@priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 50,
      "description": "Execution priority (0=lowest, 100=highest)"
    },
    "@control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@if"],
      "properties": {
        "@if": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "eq"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "eq": {}
              },
              "description": "Equality condition"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "neq"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "neq": {}
              },
              "description": "Inequality condition"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "in"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "in": { "type": "array" }
              },
              "description": "Membership condition"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "gt"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "gt": { "type": "number" }
              },
              "description": "Greater-than condition"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "lt"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "lt": { "type": "number" }
              },
              "description": "Less-than condition"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "exists"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "exists": { "type": "boolean" }
              },
              "description": "Existence condition"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["and"],
              "properties": {
                "and": { "type": "array", "items": { "$ref": "#/properties/@control/properties/@if" } }
              },
              "description": "Logical AND"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["or"],
              "properties": {
                "or": { "type": "array", "items": { "$ref": "#/properties/@control/properties/@if" } }
              },
              "description": "Logical OR"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["not"],
              "properties": {
                "not": { "$ref": "#/properties/@control/properties/@if" }
              },
              "description": "Logical NOT"
            }
          ],
          "description": "Condition to evaluate against current state"
        },
        "@then": {
          "$ref": "#/$defs/action",
          "description": "Action to execute when condition is true"
        },
        "@else": {
          "$ref": "#/$defs/action",
          "description": "Action to execute when condition is false"
        }
      },
      "description": "Control block with condition and actions"
    },
    "@meta": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional metadata for debugging/tracing"
    }
  },
  "$defs": {
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["@set"],
          "properties": {
            "@set": {
              "type": "object",
              "required": ["path", "value"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "value": {}
              }
            }
          },
          "description": "Set state value at path"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["@toggle"],
          "properties": {
            "@toggle": {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "minLength": 1 }
              }
            }
          },
          "description": "Toggle boolean value at path"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["@inc"],
          "properties": {
            "@inc": {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "by": { "type": "number", "default": 1 }
              }
            }
          },
          "description": "Increment numeric value at path"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["@dec"],
          "properties": {
            "@dec": {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "by": { "type": "number", "default": 1 }
              }
            }
          },
          "description": "Decrement numeric value at path"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["@push"],
          "properties": {
            "@push": {
              "type": "object",
              "required": ["path", "value"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "value": {}
              }
            }
          },
          "description": "Push value to array at path"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["@emit"],
          "properties": {
            "@emit": {
              "type": "object",
              "required": ["event"],
              "properties": {
                "event": { "type": "string", "minLength": 1 },
                "payload": { "type": "object" }
              }
            }
          },
          "description": "Emit a new event to the queue"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["@view"],
          "properties": {
            "@view": { "type": "string", "minLength": 1 }
          },
          "description": "Set active view (projection target)"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["@route"],
          "properties": {
            "@route": { "type": "string", "minLength": 1 }
          },
          "description": "Navigate to route"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["@sequence"],
          "properties": {
            "@sequence": {
              "type": "array",
              "items": { "$ref": "#/$defs/action" }
            }
          },
          "description": "Execute multiple actions in sequence"
        }
      ]
    }
  },
  "examples": [
    {
      "@type": "srp.directive.v1",
      "@control": {
        "@if": { "path": "ui.state", "eq": "inactive" },
        "@then": { "@set": { "path": "ui.state", "value": "active" } }
      }
    },
    {
      "@type": "srp.directive.v1",
      "@id": "dir:toggle_panel",
      "@priority": 75,
      "@control": {
        "@if": { "path": "panel.open", "eq": true },
        "@then": { "@set": { "path": "panel.open", "value": false } },
        "@else": { "@set": { "path": "panel.open", "value": true } }
      }
    },
    {
      "@type": "srp.directive.v1",
      "@control": {
        "@if": {
          "and": [
            { "path": "user.authenticated", "eq": true },
            { "path": "user.role", "in": ["admin", "editor"] }
          ]
        },
        "@then": {
          "@sequence": [
            { "@set": { "path": "ui.view", "value": "dashboard" } },
            { "@emit": { "event": "dashboard.loaded", "payload": {} } }
          ]
        }
      }
    }
  ]
}
