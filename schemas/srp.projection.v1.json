{
  "$schema": "asx://schema/xjson.draft/2020-12",
  "$id": "asx://schema/srp.projection.v1",
  "$comment": "SRP Projection Schema v1 - UI/IO output surface (replaces DOM mutation)",
  "title": "SRP Projection",
  "description": "Describes what the UI should look like, not how to mutate it. Projection is a deterministic function of state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["@type"],
  "properties": {
    "@type": {
      "const": "srp.projection.v1",
      "description": "Schema type identifier"
    },
    "@id": {
      "type": "string",
      "pattern": "^proj:[a-z0-9_]+$",
      "description": "Projection identifier"
    },
    "@ts": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix timestamp when projection was computed"
    },
    "@state_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Hash of source state (for verification)"
    },
    "@css_vars": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "CSS custom properties to set on :root"
    },
    "@dom_tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selector"],
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1,
            "description": "CSS selector for target element(s)"
          },
          "class_add": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Classes to add"
          },
          "class_remove": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Classes to remove"
          },
          "attrs": {
            "type": "object",
            "additionalProperties": { "type": ["string", "boolean", "null"] },
            "description": "Attributes to set (null = remove)"
          },
          "data": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Data attributes to set"
          },
          "text": {
            "type": "string",
            "description": "Text content to set"
          },
          "html": {
            "type": "string",
            "description": "HTML content to set (use sparingly)"
          },
          "style": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Inline styles to set"
          }
        }
      },
      "description": "DOM token operations (class, attrs, text)"
    },
    "@routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "Route path to navigate to"
          },
          "replace": {
            "type": "boolean",
            "default": false,
            "description": "Replace current history entry"
          },
          "state": {
            "type": "object",
            "description": "History state object"
          }
        }
      },
      "description": "Route navigation operations"
    },
    "@storage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["local", "session", "indexeddb"],
            "default": "local"
          },
          "op": {
            "type": "string",
            "enum": ["set", "remove", "clear"],
            "default": "set"
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {}
        }
      },
      "description": "Storage operations"
    },
    "@io": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "channel": {
            "type": "string",
            "enum": ["console", "notification", "clipboard", "audio", "vibration"],
            "description": "IO channel"
          },
          "action": {
            "type": "string",
            "description": "Channel-specific action"
          },
          "payload": {
            "description": "Action payload"
          }
        }
      },
      "description": "IO surface operations"
    },
    "@network": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["fetch", "websocket", "sse"],
            "default": "fetch"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "method": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"],
            "default": "GET"
          },
          "headers": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "body": {},
          "on_success": {
            "type": "string",
            "description": "Event name to emit on success"
          },
          "on_error": {
            "type": "string",
            "description": "Event name to emit on error"
          }
        }
      },
      "description": "Network operations (controlled side-effects)"
    },
    "@meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "examples": [
    {
      "@type": "srp.projection.v1",
      "@css_vars": {
        "--ui-state": "active",
        "--theme": "dark"
      },
      "@dom_tokens": [
        {
          "selector": "#panel",
          "class_add": ["active"],
          "class_remove": ["inactive"]
        },
        {
          "selector": "#status",
          "text": "Active",
          "data": { "state": "active" }
        }
      ]
    },
    {
      "@type": "srp.projection.v1",
      "@id": "proj:phase_update",
      "@ts": 1735570800000,
      "@dom_tokens": [
        {
          "selector": ".phase-card[data-phase='pop']",
          "class_add": ["completed"],
          "attrs": { "data-status": "completed" }
        },
        {
          "selector": ".phase-card[data-phase='wo']",
          "class_add": ["active"],
          "attrs": { "data-status": "active" }
        },
        {
          "selector": "#progress-bar",
          "style": { "width": "50%" }
        }
      ],
      "@storage": [
        {
          "type": "local",
          "key": "tracker_state",
          "value": { "phase": "wo", "progress": 50 }
        }
      ]
    },
    {
      "@type": "srp.projection.v1",
      "@routes": [
        { "path": "/dashboard", "replace": false }
      ],
      "@io": [
        {
          "channel": "notification",
          "action": "show",
          "payload": { "title": "Phase Complete", "body": "@Pop phase finished" }
        }
      ]
    }
  ]
}
